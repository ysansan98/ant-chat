{
  "compilerOptions": {
    "composite": true,
    "target": "ES2020",
    "baseUrl": ".",
    "rootDir": "../..",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@ant-chat/shared": ["../shared/src/index.ts"]
    },
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "outDir": "dist",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*", "../shared/src/**/*"],
  "exclude": ["node_modules", "dist"]
}
