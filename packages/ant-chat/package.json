{
  "name": "ant-chat",
  "type": "module",
  "version": "1.0.0-alpha.1",
  "description": "Ant Chat 本地 Agent 产品运行时",
  "license": "MIT",
  "exports": {
    ".": {
      "development": { "types": "./src/index.ts", "default": "./src/index.ts" },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "bin": {
    "ant-chat": "./dist/cli.mjs"
  },
  "files": [
    "CHANGELOG.md",
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown && node ../../scripts/copy-product-builtin-skills.mjs && pnpm -F @ant-chat/web build --outDir ../../packages/ant-chat/dist/web --emptyOutDir false",
    "clean": "rm -rf dist node_modules",
    "dev": "node ../../scripts/link-cli-dev.mjs && tsx watch --conditions=development --exclude '../../apps/web/node_modules' --exclude '../../apps/web/dist' --exclude '../../apps/desktop/out' --exclude '../../apps/desktop/release' src/dev.ts",
    "dev:web": "node ../../scripts/link-cli-dev.mjs && PATH=\"$PWD/../../node_modules/.bin:$PATH\" tsx watch --conditions=development --exclude '../../apps/web/node_modules' --exclude '../../apps/web/dist' --exclude '../../apps/desktop/out' --exclude '../../apps/desktop/release' src/dev.ts --web",
    "prepack": "pnpm build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "catalog:",
    "keytar": "catalog:"
  },
  "devDependencies": {
    "@ant-chat/backend": "workspace:^",
    "@ant-chat/control-client": "workspace:^",
    "@ant-chat/shared": "workspace:^",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
