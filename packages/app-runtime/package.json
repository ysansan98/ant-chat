{
  "name": "@ant-chat/app-runtime",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./rpc-handlers": {
      "development": {
        "types": "./src/rpcHandlers.ts",
        "default": "./src/rpcHandlers.ts"
      },
      "import": "./dist/rpc-handlers.mjs",
      "require": "./dist/rpc-handlers.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist node_modules",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ant-chat/agent-core": "workspace:^",
    "@ant-chat/agent-runtime": "workspace:^",
    "@ant-chat/app-data": "workspace:^",
    "@ant-chat/mcp-client-hub": "workspace:^",
    "@ant-chat/shared": "workspace:^",
    "better-sqlite3": "catalog:",
    "keytar": "^7.9.0",
    "undici": "^7.15.0"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
