{
  "name": "@ant-chat/backend",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "development": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./rpc-handlers": {
      "development": {
        "types": "./src/rpcHandlers.ts",
        "default": "./src/rpcHandlers.ts"
      },
      "import": "./dist/rpc-handlers.mjs",
      "require": "./dist/rpc-handlers.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf dist node_modules",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.36",
    "@ai-sdk/deepseek": "^2.0.34",
    "@ai-sdk/google": "^3.0.20",
    "@ai-sdk/openai": "^3.0.25",
    "@ant-chat/shared": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^6.0.69",
    "better-sqlite3": "catalog:",
    "fast-deep-equal": "^3.1.3",
    "fflate": "^0.8.2",
    "js-yaml": "^4.1.0",
    "keytar": "^7.9.0",
    "nanoid": "^5.0.9",
    "undici": "^7.15.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.16.4",
    "@types/js-yaml": "^4.0.9",
    "openai": "^5.23.2",
    "tsdown": "catalog:",
    "vitest": "catalog:"
  }
}
