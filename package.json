{
  "name": "ant-chat-workspace",
  "version": "1.0.0-alpha.1",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "description": "Ant Chat Monorepo",
  "author": {
    "email": "ysansan.tech@icloud.com",
    "name": "幺叁叁"
  },
  "scripts": {
    "build:packages": "pnpm -F @ant-chat/shared build && pnpm -F @ant-chat/control-client build && pnpm -F @ant-chat/backend build && pnpm -F ant-chat build",
    "dev": "pnpm -F @ant-chat/desktop dev",
    "dev:web": "pnpm -F ant-chat dev:web",
    "build": "pnpm build:packages && pnpm -F @ant-chat/desktop build",
    "build:win": "pnpm build:packages && pnpm -F @ant-chat/desktop build:win",
    "build:mac": "pnpm build:packages && pnpm -F @ant-chat/desktop build:mac",
    "visualize:render": "node scripts/render-visualization.mjs",
    "type-check": "tsc -b",
    "test:unit": "pnpm -r test",
    "rebuild:node": "pnpm -r rebuild better-sqlite3 keytar",
    "check": "pnpm type-check && pnpm lint && pnpm test:unit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "lint": "eslint .",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.1.0",
    "@changesets/cli": "^2.31.0",
    "@eslint-react/eslint-plugin": "^5.17.0",
    "eslint": "^10.7.0",
    "eslint-plugin-better-tailwindcss": "^4.6.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "lint-staged": "^15.3.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
