{
  "name": "ant-chat",
  "version": "1.0.0-alpha.1",
  "private": true,
  "packageManager": "pnpm@11.2.2",
  "description": "Ant Chat Monorepo",
  "author": {
    "email": "ysansan.tech@icloud.com",
    "name": "幺叁叁"
  },
  "scripts": {
    "build:packages": "pnpm -F @ant-chat/shared build && pnpm -F @ant-chat/backend build && pnpm -F @ant-chat/local-server build",
    "dev": "pnpm -F @ant-chat/desktop dev",
    "dev:web": "pnpm -F @ant-chat/local-server dev:web",
    "build": "pnpm build:packages && pnpm -F @ant-chat/desktop build",
    "build:win": "pnpm build:packages && pnpm -F @ant-chat/desktop build:win",
    "build:mac": "pnpm build:packages && pnpm -F @ant-chat/desktop build:mac",
    "type-check": "tsc -b",
    "test:unit": "pnpm -r test",
    "rebuild:node": "pnpm -r rebuild better-sqlite3",
    "check": "pnpm type-check && pnpm lint && pnpm test:unit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "lint": "eslint .",
    "clean": "pnpm -r run clean && rm -rf node_modules"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@changesets/cli": "^2.31.0",
    "@eslint-react/eslint-plugin": "^2.3.9",
    "@eslint/js": "catalog:",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "cross-env": "^7.0.3",
    "eslint": "^9.31.0",
    "eslint-plugin-better-tailwindcss": "^4.4.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.18.1",
    "simple-git-hooks": "^2.13.1",
    "tsx": "^4.19.3",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
