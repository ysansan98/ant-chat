{
  "name": "ant-chat",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Ant Chat Monorepo",
  "author": {
    "email": "ysansan.tech@icloud.com",
    "name": "幺叁叁"
  },
  "scripts": {
    "build:packages": "pnpm -F @ant-chat/shared build && pnpm -F @ant-chat/runtime build && pnpm -F @ant-chat/app-data build && pnpm -F @ant-chat/local-server build && pnpm -F @ant-chat/mcp-client-hub build",
    "dev": "pnpm build:packages && pnpm -F @ant-chat/desktop dev",
    "build": "pnpm build:packages && pnpm -F @ant-chat/desktop build",
    "build:win": "pnpm build:packages && pnpm -F @ant-chat/desktop build:win",
    "build:mac": "pnpm build:packages && pnpm -F @ant-chat/desktop build:mac",
    "type-check": "tsc -b",
    "test:unit": "vitest -c ./vitest.config.ts",
    "test:ui": "vitest -c ./vitest.ui.config.ts",
    "test:e2e": "pnpm -F @ant-chat/desktop test:e2e",
    "check": "pnpm type-check && pnpm lint && pnpm test:unit",
    "check:all": "pnpm check && pnpm test:ui && pnpm test:e2e",
    "lint": "eslint .",
    "clean": "pnpm -F @ant-chat/desktop clean && rm -rf node_modules"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint-react/eslint-plugin": "^2.3.9",
    "@eslint/js": "catalog:",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "4.0.14",
    "@vitest/ui": "4.0.14",
    "cross-env": "^7.0.3",
    "eslint": "^9.31.0",
    "eslint-plugin-better-tailwindcss": "^4.4.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "lint-staged": "^15.3.0",
    "tsx": "^4.19.3",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "4.0.14"
  }
}
