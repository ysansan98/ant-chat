{
  "name": "ant-chat",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Ant Chat Electron App",
  "author": {
    "email": "ysansan.tech@icloud.com",
    "name": "幺叁叁"
  },
  "main": "out/main/index.cjs",
  "scripts": {
    "start": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev -- --remote-debugging-port=9222",
    "debug:check": "node scripts/check-remote-debugging.cjs",
    "prebuild": "electron-vite build",
    "type-check": "tsc -b",
    "test:unit": "vitest -c ./vitest.config.ts",
    "analyze:renderer": "VISUALIZER_RENDERER=true pnpm build",
    "analyze:main": "VISUALIZER_MAIN=true pnpm build",
    "rebuild:electron": "pnpm dlx electron-rebuild -f -w better-sqlite3",
    "rebuild:node": "pnpm rebuild better-sqlite3",
    "build": "cross-env NODE_ENV=production electron-vite build",
    "build:win": "cross-env NODE_ENV=production electron-vite build && electron-builder --win",
    "build:mac": "cross-env NODE_ENV=production electron-vite build && electron-builder --mac",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cross-env NODE_ENV=development tsx src/main/db/migrate.ts",
    "lint": "eslint .",
    "clean": "rm -rf node_modules out release && pnpm -r clean"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.36",
    "@ai-sdk/google": "^3.0.20",
    "@ai-sdk/openai": "^3.0.25",
    "@google/genai": "^1.32.0",
    "ai": "^6.0.69",
    "better-sqlite3": "^12.6.2",
    "drizzle-orm": "^0.40.0",
    "electron-ipc-decorator": "^1.0.0",
    "electron-log": "^5.4.0",
    "electron-store": "^8.0.0",
    "electron-updater": "^6.2.0",
    "openai": "^5.23.2",
    "undici": "^7.15.0"
  },
  "devDependencies": {
    "@ai-sdk/deepseek": "^2.0.17",
    "@ant-chat/mcp-client-hub": "workspace:*",
    "@ant-chat/shared": "workspace:*",
    "@ant-design/icons": "^6.1.0",
    "@ant-design/x": "^2.0.0",
    "@antfu/eslint-config": "^6.2.0",
    "@antv/infographic": "^0.2.13",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/typed-ipc": "^1.0.2",
    "@electron/notarize": "^3.1.0",
    "@electron/rebuild": "^4.0.1",
    "@eslint-react/eslint-plugin": "^2.3.9",
    "@eslint/js": "^9.17.0",
    "@ferrucc-io/emoji-picker": "^0.0.44",
    "@iconify-json/tdesign": "^1.2.8",
    "@iconify/tailwind4": "^1.0.6",
    "@lobehub/tts": "^2.0.1",
    "@tailwindcss/vite": "^4.1.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/wicg-file-system-access": "^2023.10.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "4.0.14",
    "@vitest/ui": "4.0.14",
    "@workspace/ui": "workspace:*",
    "ahooks": "^3.8.4",
    "antd": "^6.0.0",
    "babel-plugin-react-compiler": "1.0.0",
    "code-inspector-plugin": "^0.20.1",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.13",
    "drizzle-kit": "^0.31.1",
    "drizzle-zod": "^0.7.1",
    "electron": "^40.0.0",
    "electron-builder": "^26.9.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "6.0.0-beta.1",
    "eslint": "^9.31.0",
    "eslint-plugin-better-tailwindcss": "^4.4.0",
    "eslint-plugin-format": "^1.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.20",
    "husky": "^9.1.7",
    "immer": "^10.1.1",
    "js-base64": "^3.7.7",
    "jsdom": "^26.0.0",
    "katex": "^0.16.28",
    "lint-staged": "^15.3.0",
    "lodash-es": "^4.17.21",
    "markstream-react": "^0.0.20-beta.1",
    "mermaid": "^11.5.0",
    "motion": "^12.23.5",
    "nanoid": "^5.0.9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.5.3",
    "react-scan": "^0.3.4",
    "stream-markdown": "^0.0.13",
    "stream-monaco": "^0.0.18",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.19.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.19.0",
    "use-immer": "^0.11.0",
    "vite": "^8.0.0",
    "vite-bundle-analyzer": "^1.3.2",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "4.0.14",
    "zod": "^3.24.4",
    "zustand": "^5.0.3"
  }
}
