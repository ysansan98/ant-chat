{
  "name": "@ant-chat/desktop",
  "version": "1.0.0-alpha.1",
  "private": true,
  "description": "Ant Chat Electron Desktop App",
  "author": {
    "email": "ysansan.tech@icloud.com",
    "name": "幺叁叁"
  },
  "main": "out/main/index.cjs",
  "scripts": {
    "start": "electron-vite preview",
    "install-electron": "electron-builder install-app-deps",
    "prestart": "pnpm rebuild:electron",
    "dev": "electron-vite dev",
    "predev": "pnpm rebuild:electron",
    "dev:debug": "electron-vite dev -- --remote-debugging-port=9222",
    "predev:debug": "pnpm rebuild:electron",
    "debug:check": "node scripts/check-remote-debugging.cjs",
    "rg:prepare": "tsx scripts/fetch-rg.ts",
    "prebuild": "electron-vite build",
    "type-check": "tsc -b",
    "test": "vitest run",
    "check": "pnpm type-check && pnpm lint && pnpm test",
    "analyze:main": "VISUALIZER_MAIN=true pnpm build",
    "rebuild:electron": "electron-rebuild -f -w better-sqlite3",
    "build": "cross-env NODE_ENV=production electron-vite build",
    "build:win": "pnpm rg:prepare && cross-env NODE_ENV=production electron-vite build && electron-builder --win",
    "build:mac": "pnpm rg:prepare && cross-env NODE_ENV=production electron-vite build && electron-builder --mac",
    "lint": "eslint .",
    "clean": "rm -rf node_modules out release"
  },
  "dependencies": {
    "better-sqlite3": "catalog:",
    "electron-ipc-decorator": "^1.0.0",
    "electron-store": "^8.0.0",
    "electron-updater": "^6.2.0",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@ant-chat/backend": "workspace:*",
    "@ant-chat/shared": "workspace:*",
    "@copilotkit/aimock": "^1.16.4",
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron-toolkit/typed-ipc": "^1.0.2",
    "@electron/notarize": "^3.1.0",
    "@electron/rebuild": "^4.0.1",
    "@tailwindcss/vite": "catalog:",
    "@vitejs/plugin-react": "^5.2.0",
    "@workspace/ui": "workspace:*",
    "babel-plugin-react-compiler": "1.0.0",
    "code-inspector-plugin": "catalog:",
    "electron": "^40.6.1",
    "electron-builder": "^26.9.0",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "6.0.0-beta.1",
    "openai": "^5.23.2",
    "tailwindcss": "catalog:",
    "vite": "^8.0.0",
    "vite-bundle-analyzer": "catalog:",
    "vite-plugin-svgr": "^5.2.0"
  }
}
